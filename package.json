{
  "name": "kagami",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig tsconfig.json",
    "build": "npm run check && vite build",
    "test": "vitest run",
    "test:core": "cargo test -p kagami-core",
    "test:ui": "cargo build -p kagami-driver && playwright test",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "lint:rust": "cargo clippy -p kagami-core -p kagami-driver --all-targets -- -D warnings",
    "desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:windows": "node scripts/build-windows.mjs",
    "build:windows:test": "node scripts/build-windows.mjs --test-profile",
    "bundle:windows": "node scripts/build-windows.mjs --bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
